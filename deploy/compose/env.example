# Local Compose only. Copy to .env.compose and replace every development secret.
RELEASE_COMMIT=0000000000000000000000000000000000000000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
SECRETS_ENCRYPTION_KEY=replace-with-64-hex-characters
USEAGENT_OPERATOR_SECRET=replace-with-random-operator-secret
PROVIDER_GATEWAY_SECRET=replace-with-random-provider-gateway-secret
TOOL_GATEWAY_SECRET=replace-with-random-tool-gateway-secret
# Every sandbox engine (OpenCode, Claude, Codex, Pi) reaches models and tools
# through the gateway process. Engine readiness reports `gateway_unconfigured`
# and POST /api/runs answers 403 until GATEWAY_PUBLIC_URL and
# PROVIDER_GATEWAY_SECRET are set on the backend.
GATEWAY_PUBLIC_URL=https://replace-with-your-sandbox-reachable-gateway.example

# The gateway process (bun run src/gateway.ts) needs, besides the three secrets
# and GATEWAY_PUBLIC_URL above: GATEWAY_DATABASE_URL (its restricted role; any
# value switches it to bridge mode), USEAGENT_API_ORIGIN (the backend's origin,
# where child-session, handoff and approval tools are executed and where the
# gateway reads the product flags it advertises), FRONTEND_ORIGIN, and the same
# sandbox provider credential as the backend. Give it the same PRODUCT_CHILD_THREADS
# and BOTS values as the backend: it advertises the backend's answer and logs an
# error on every refresh while they disagree.
# GATEWAY_DATABASE_URL=postgres://useagent_gateway@db/useagent
# USEAGENT_API_ORIGIN=http://backend:3201

# Select one sandbox provider for local runs. Cube remains external to Compose.
SANDBOX_PROVIDER=daytona
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
# The product snapshot. Leave it unset to use the pin in
# packages/sandbox-daytona (skynet-agent-v17). skynet-agent-v23 also exists in
# the product org but lacks the desktop binaries the Browser surface needs. A
# snapshot Daytona has parked as inactive is activated on the next run (a
# visible "Activating sandbox image" step, a few minutes); a snapshot that is
# not in the org fails the run by name.
# DAYTONA_SNAPSHOT=skynet-agent-v17

# To use an external Cube development VM instead:
# Box (box.ascii.dev): a Linux VM per sandbox with Claude, Codex, OpenCode and
# Pi preinstalled. Create a box from the base image, install the useAgent
# runtime, snapshot it, and set BOX_SNAPSHOT to that snapshot; leave it empty
# to start from the base image. Machine types: small (2 vCPU/4 GB),
# default (4/8), large (8/16); `small` needs SANDBOX_CPU=2 SANDBOX_MEMORY_GIB=4
# or every create fails the resource target. Box has no idle auto-stop: a box
# lives for SANDBOX_AUTO_DELETE_MIN (absolute) and is deleted by cleanup.
# Boxes run as `user` (not root), so the T3 runtime lane is unavailable and
# engines use the CLI lane. The base image's `opencode` is a launcher shim that
# never answers; OpenCode detects that and boots through `npx opencode-ai@<pin>`
# with a visible step. Interactive terminals ride the Box CLI (`box ssh`), so
# the `box` binary must be on the useAgent server's PATH; without it the
# terminal pane says so once instead of reconnecting.
# SANDBOX_PROVIDER=box
# BOX_API_KEY=box_...
# BOX_API_URL=https://ascii.dev/api/box/v1
# BOX_SNAPSHOT=useagent-runtime
# BOX_MACHINE_TYPE=default
# BOX_ENVIRONMENT=
# BOX_HOSTING_DOMAIN=on.ascii.dev

# Personal computers: when on, a user who connected a Daytona or Box key in
# Settings > Infrastructure runs their own threads on that account; the run
# records which provider made its sandbox so previews, files, recordings and
# cleanup keep talking to it. Off = everything runs on the server's provider.
# USER_COMPUTERS=off

# SANDBOX_PROVIDER=cube
# CUBE_API_URL=http://host.docker.internal:3000
# CUBE_API_KEY=e2b_000000
# CUBE_TEMPLATE_ID=<template-id>
# CUBE_SANDBOX_DOMAIN=cube.app

# Bots (named presets over durable home threads, handoffs with @bot) are on for
# every org. BOTS=off is the kill switch. Handoffs also need PRODUCT_CHILD_THREADS=on,
# which also enables messaging a child thread (there is no separate composer switch).
# BOTS=on
