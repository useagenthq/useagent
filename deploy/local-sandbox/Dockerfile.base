# Base of the image a developer's machine boots for local sandboxes: what the
# cloud sandbox base provides, on a public Debian, for amd64 and arm64. The
# native recipe (backend/src/sandboxes/native-image.ts, rendered by
# backend/scripts/render-native-image.ts --layout local) is applied on top by
# .github/workflows/local-sandbox-image.yml, so a local sandbox carries the
# same runtime, drivers and toolchains the cloud does.
#
# Non-root: the runner executes everything as uid 1000 (`user`), whose home is
# /home/user, and the recipe's apt steps use passwordless sudo.

# Pinned to the index digest so every publish starts from the same Debian; move
# the digest deliberately, with the rest of the versions below.
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

ARG NODE_VERSION=24.19.0
ARG BUN_VERSION=1.3.14
ARG T3_CODE_VERSION=0.0.39-nightly.20260906.1293
ARG CODEX_CLI_VERSION=0.162.1
ARG CLAUDE_CODE_VERSION=2.1.296
ARG OPENCODE_VERSION=1.18.7

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      acl \
      adwaita-icon-theme \
      bash \
      budgie-core \
      build-essential \
      ca-certificates \
      chromium \
      curl \
      dbus-x11 \
      dconf-cli \
      ffmpeg \
      fonts-cantarell \
      fonts-noto-mono \
      gir1.2-budgie-1.0 \
      gir1.2-peas-1.0 \
      git \
      gnome-backgrounds \
      gnome-settings-daemon \
      gnome-terminal \
      hicolor-icon-theme \
      jq \
      libglib2.0-bin \
      librsvg2-common \
      novnc \
      openssh-client \
      pcmanfm \
      procps \
      python3 \
      python3-pip \
      ripgrep \
      socat \
      sudo \
      unzip \
      upower \
      webp-pixbuf-loader \
      websockify \
      x11-utils \
      x11vnc \
      xclip \
      xdotool \
      xserver-xorg-core \
      xserver-xorg-legacy \
      xserver-xorg-video-dummy \
      xz-utils \
    && mkdir -p /usr/share/useagent \
    && dpkg-query -W -f '${binary:Package}=${Version}\n' > /usr/share/useagent/base-packages.txt \
    && rm -rf /var/lib/apt/lists/*

# The panel loads its applets through libpeas and its own typelib (gir1.2-peas-1.0,
# gir1.2-budgie-1.0); Debian's budgie-core does not depend on them, and without them
# the panel logs "Typelib file for namespace 'Peas' not found" and runs empty. Its
# status applet then needs UPower on the system bus (upower; the launcher starts the
# bus as root through sudo on this unprivileged layout) or it dereferences a null client.
# The desktop (Budgie on a real Xorg dummy display at 1920x1080, x11vnc and
# noVNC for the stream) is the stack the native recipe's desktop step installs
# on the cloud bases. Here it is part of the base, so that step finds it
# complete and stops before writing its own files: rootfs/ carries those files
# instead (the display and dconf defaults here, the home files below), and
# backend/src/sandboxes/local-sandbox-base.test.ts holds them equal to the
# recipe. The wrapper config runs Xorg as the user on this layout: a container
# without CAP_IPC_OWNER (Docker's default) lets a root Xorg attach none of the
# shared-memory segments x11vnc creates as uid 1000.
COPY rootfs/etc /etc
RUN dconf update \
    && test -r /usr/share/dbus-1/system-services/org.freedesktop.UPower.service \
    && gtk-update-icon-cache -f -q /usr/share/icons/Adwaita \
    && gtk-update-icon-cache -f -q /usr/share/icons/hicolor \
    && for binary in Xorg budgie-daemon budgie-panel budgie-wm dbus-launch dconf gnome-terminal pcmanfm pgrep websockify x11vnc xdotool xdpyinfo chromium; do \
         command -v "$binary" >/dev/null || { echo "missing $binary" >&2; exit 1; }; \
       done \
    && test -x /usr/libexec/gsd-xsettings \
    && ls /usr/lib/*/girepository-1.0/Peas-1.0.typelib /usr/lib/*/girepository-1.0/Budgie-1.0.typelib >/dev/null \
    && test -r /usr/share/novnc/vnc.html \
    && test -r /etc/dconf/db/local

# Node from the official tarball for this architecture, checked against the
# release's checksum list; Bun from its release archive, checked the same way.
RUN set -eux; \
    case "$(uname -m)" in \
      x86_64) node_arch=x64; bun_arch=x64;; \
      aarch64) node_arch=arm64; bun_arch=aarch64;; \
      *) echo "unsupported architecture $(uname -m)" >&2; exit 1;; \
    esac; \
    cd /tmp; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt"; \
    grep " node-v${NODE_VERSION}-linux-${node_arch}.tar.xz\$" SHASUMS256.txt | sha256sum -c -; \
    tar -xJf "node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" --strip-components=1 -C /usr/local; \
    curl -fsSLO "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-${bun_arch}.zip"; \
    curl -fsSLO "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/SHASUMS256.txt"; \
    grep " bun-linux-${bun_arch}.zip\$" SHASUMS256.txt | sha256sum -c -; \
    unzip -q "bun-linux-${bun_arch}.zip"; \
    install -m 0755 "bun-linux-${bun_arch}/bun" /usr/local/bin/bun; \
    rm -rf /tmp/*; \
    test "$(node --version)" = "v${NODE_VERSION}"; \
    test "$(bun --version)" = "${BUN_VERSION}"

RUN npm install --global \
      "@openai/codex@${CODEX_CLI_VERSION}" \
      "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
      "opencode-ai@${OPENCODE_VERSION}" \
      "t3@${T3_CODE_VERSION}" \
    && npm cache clean --force \
    && command -v claude && command -v codex && command -v opencode && command -v t3 \
    && t3 --version && codex --version && opencode --version && claude --version

RUN useradd -m -u 1000 -s /bin/bash user \
    && mkdir -p /home/user/work \
    && chown -R user:user /home/user \
    && printf 'user ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/user \
    && chmod 0440 /etc/sudoers.d/user \
    && test "$(id -u user)" = 1000 \
    && command -v setfacl && command -v setpriv && command -v socat

# The desktop's home files: the wallpaper and icons pcmanfm draws, the launchers.
COPY --chown=user:user rootfs/home/user /home/user
RUN test -x /home/user/Desktop/files.desktop \
    && test -r /home/user/.config/pcmanfm/useagent/desktop-items-0.conf

USER user
ENV HOME=/home/user
WORKDIR /home/user/work
CMD ["sleep", "infinity"]
