# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# The Hetzner API token is NOT here - export it instead:
#   export HCLOUD_TOKEN=your-hetzner-api-token

ssh_public_key_path = "~/.ssh/id_ed25519.pub"
postgres_password   = "change-me-to-a-strong-secret"

# Optional overrides:
# server_type       = "cpx41"
# location          = "nbg1"
# allowed_ssh_cidrs = ["203.0.113.4/32"]
